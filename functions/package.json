{
  "name": "savingor-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,mjs,md}\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,mjs,md}\"",
    "lint": "eslint src test",
    "test": "vitest run --exclude test/firestoreRules.emulator.test.ts",
    "test:rules": "vitest run test/firestoreRules.emulator.test.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project savingor-smart-receipt-test \"npm run test:rules\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.24.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
